# ============================================================
# ReviveAI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.
# ============================================================

# --- Application ---
APP_NAME=ReviveAI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# SQLite (default for development — zero external setup)
DATABASE_URL=sqlite:///./reviveai.db
# PostgreSQL (for production / AWS RDS / Aurora)
# DATABASE_URL=postgresql://reviveai:YOUR_SECURE_PASSWORD@your-rds-cluster.amazonaws.com:5432/reviveai

# --- AI & LLM Providers ---
# Options: "auto", "gemini", "openai_compatible", "ollama", "heuristic"
LLM_PROVIDER=auto
LLM_MODEL=gemini-2.5-flash

# API Keys (Provide at least one for live LLM routing; heuristic engine works offline)
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OLLAMA_BASE_URL=http://localhost:11434

# --- Webhook Security ---
WEBHOOK_SECRET=reviveai_sec_demo_2026

# --- RAG Subsystem ---
RAG_CHUNK_SIZE=300
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=3

# --- Cloud & AWS Infrastructure ---
AWS_REGION=us-east-1
AWS_SECRET_NAME=reviveai/production/secrets

# --- MLOps & Experiment Tracking ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- API & Networking ---
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=["*"]
