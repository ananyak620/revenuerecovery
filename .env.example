# ============================================================
# ReviveAI — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# Never commit the .env file to version control.
# ============================================================

# --- App ---
APP_NAME=ReviveAI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# --- Database ---
# SQLite (default for development — no setup needed)
DATABASE_URL=sqlite:///./reviveai.db

# PostgreSQL (uncomment for production / Phase 7+)
# DATABASE_URL=postgresql://reviveai:reviveai@localhost:5432/reviveai

# --- AI / GenAI ---
# Get your free API key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- MLflow ---
MLFLOW_TRACKING_URI=sqlite:///mlflow.db

# --- Redis (Phase 7+) ---
# REDIS_URL=redis://localhost:6379/0

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
